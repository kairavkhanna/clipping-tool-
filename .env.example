# Copy this file to .env and fill it in.
DOMAIN=clip.yourdomain.com
CLIPPER_USER=clipper
CLIPPER_PASSWORD=put-a-long-random-password-here

# Optional settings
# Videos and clips older than this many hours are deleted automatically (0 = keep forever)
RETENTION_HOURS=48
MAX_UPLOAD_MB=2048
# How many ffmpeg jobs may run at the same time
MAX_CONCURRENT_JOBS=2
# Speech model for captions: base (faster, needs less memory) or small (more accurate)
CLIPPER_WHISPER_MODEL=small
# Optional: how many CPU cores captions/transcription use (default: all but one)
# CLIPPER_WHISPER_THREADS=4
# Optional: a key for the AI features. You can also paste it in the app.
# Gemini (free tier, aistudio.google.com/app/apikey):
GEMINI_API_KEY=
# Or Anthropic (pay as you go):
ANTHROPIC_API_KEY=
